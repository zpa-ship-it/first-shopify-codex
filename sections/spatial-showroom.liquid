{% assign collection = section.settings.collection %}
{% assign interaction_source = section.settings.interaction_video.sources | first %}

<section
  class="spatial-showroom"
  aria-label="{{ section.settings.heading | escape }}"
  data-spatial-showroom
  {% if interaction_source != blank %}
    data-interaction-video="{{ interaction_source.url }}"
    data-interaction-video-type="{{ interaction_source.mime_type }}"
  {% endif %}
>
  {% if section.settings.video != blank %}
    <video class="spatial-showroom__backdrop" autoplay muted loop playsinline preload="metadata">
      {% for source in section.settings.video.sources %}
        <source src="{{ source.url }}" type="{{ source.mime_type }}">
      {% endfor %}
    </video>
  {% elsif section.settings.image != blank %}
    <img
      class="spatial-showroom__backdrop"
      src="{{ section.settings.image | image_url: width: 2400 }}"
      alt="{{ section.settings.image.alt | escape }}"
      width="{{ section.settings.image.width }}"
      height="{{ section.settings.image.height }}"
      loading="eager"
    >
  {% endif %}

  <div class="spatial-showroom__field" aria-hidden="true">
    <span></span>
    <span></span>
    <span></span>
    <span></span>
  </div>

  <div class="spatial-showroom__core" data-alive-tilt>
    <div class="spatial-showroom__halo" aria-hidden="true"></div>
    <div class="spatial-showroom__console">
      <p>{{ section.settings.eyebrow }}</p>
      <h1>{{ section.settings.heading }}</h1>
      <div class="spatial-showroom__signal">
        <span></span>
        <strong>{{ section.settings.signal }}</strong>
      </div>
    </div>
  </div>

  <div class="portal-ring" aria-label="Featured products">
    {% if collection != blank and collection.products_count > 0 %}
      {% for product in collection.products limit: 6 %}
        <a
          class="portal-ring__item"
          href="{{ product.url }}"
          style="--portal-index: {{ forloop.index0 }};"
          data-portal
        >
          <span class="portal-ring__frame">
            {% if product.featured_media %}
              {{ product.featured_media | image_url: width: 760 | image_tag: loading: 'eager', widths: '360, 520, 760', sizes: '220px' }}
            {% else %}
              <span class="portal-ring__empty"></span>
            {% endif %}
          </span>
          <span class="portal-ring__meta">
            <span>{{ product.title }}</span>
            <strong>{{ product.price | money }}</strong>
          </span>
        </a>
      {% endfor %}
    {% else %}
      {% for i in (1..6) %}
        <a class="portal-ring__item" href="{{ routes.all_products_collection_url }}" style="--portal-index: {{ forloop.index0 }};" data-portal>
          <span class="portal-ring__frame">
            <span class="portal-ring__empty"></span>
          </span>
          <span class="portal-ring__meta">
            <span>Portal {{ i }}</span>
            <strong>Coming online</strong>
          </span>
        </a>
      {% endfor %}
    {% endif %}
  </div>

  <div class="spatial-showroom__dock">
    {% if section.settings.primary_label != blank %}
      <a class="button-glass button-glass--primary" href="{{ section.settings.primary_link }}">{{ section.settings.primary_label }}</a>
    {% endif %}
    {% if section.settings.secondary_label != blank %}
      <a class="button-glass" href="{{ section.settings.secondary_link }}">{{ section.settings.secondary_label }}</a>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "2050 spatial showroom",
  "settings": [
    {
      "type": "video",
      "id": "video",
      "label": "Living background video"
    },
    {
      "type": "video",
      "id": "interaction_video",
      "label": "Video launched by interactions"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Fallback image"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Portal collection"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Codex build"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Commerce from 2050"
    },
    {
      "type": "text",
      "id": "signal",
      "label": "Signal",
      "default": "Every interaction opens a scene"
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Primary action",
      "default": "Open portals"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Primary link"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary action",
      "default": "All products"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary link"
    }
  ],
  "presets": [
    {
      "name": "2050 spatial showroom"
    }
  ]
}
{% endschema %}
